# Copy to .env in the repository root and fill in. Git ignores .env.

# Your TweetStream API key: https://tweetstream.io/dashboard?tab=api&utm_source=github&utm_medium=referral&utm_campaign=solana-sniper-bot&utm_content=env-example
TWEETSTREAM_API_KEY=
# Optional: an Ultra Speed key for the accounts you snipe. The bot connects with both keys and keeps
# the first copy of each event.
TWEETSTREAM_ULTRA_API_KEY=
# US endpoint. Outside the US use wss://ws-global.tweetstream.io/ws
TWEETSTREAM_WS_URL=wss://ws-iad.tweetstream.io/ws

# Dry run prints what the bot would trade and sends nothing. Set to false to trade with real SOL.
DRY_RUN=true
# Base58 secret key of a wallet that holds only what you can lose. Required when DRY_RUN=false.
WALLET_SECRET_KEY=

# Solana RPC endpoints, comma separated. The first serves reads; transactions go to all of them.
# Use your own endpoint. The public one below rate-limits the bot (HTTP 429) and is only fit
# for trying the bot out.
SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com
# WebSocket for confirmations. Defaults to the first RPC URL with ws(s)://.
SOLANA_WS_URL=
# Jito block engine. NY is closest to Ashburn. Set to off to disable.
JITO_URL=https://ny.mainnet.block-engine.jito.wtf
# Optional Jupiter API key; without one Jupiter allows 0.5 requests per second.
JUPITER_API_KEY=

# Optional paths, relative to the repository root.
SNIPER_CONFIG=config.json
STATE_DIR=state
