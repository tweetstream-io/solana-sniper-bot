{
  "description": "Contract address extraction rules shared by both bots. See shared/README.md, section Detection and matching.",
  "solana": {
    "pattern": "[1-9A-HJ-NP-Za-km-z]{32,44}",
    "decodedBytes": 32
  },
  "evm": {
    "pattern": "0x[0-9a-fA-F]{40}",
    "lowercase": true
  },
  "standalone": {
    "wordChars": "[0-9A-Za-z]",
    "rule": "A candidate counts only when the characters directly before and after it are not word characters."
  },
  "linkInText": {
    "pattern": "(?:https?://)?(?:[a-z0-9-]+\\.)*(?:pump\\.fun|birdeye\\.so|jup\\.ag|dexscreener\\.com)/[^\\s)\\]}>\"']+",
    "flags": "gi",
    "stripTrailing": ".,;:!?"
  },
  "links": [
    {
      "via": "pump.fun",
      "host": "(^|\\.)pump\\.fun$",
      "path": "^/(?:coin/)?([1-9A-HJ-NP-Za-km-z]{32,44})/?$",
      "confidence": "high"
    },
    {
      "via": "birdeye",
      "host": "(^|\\.)birdeye\\.so$",
      "path": "^/(?:solana/)?token/([1-9A-HJ-NP-Za-km-z]{32,44})/?$",
      "confidence": "high"
    },
    {
      "via": "jupiter",
      "host": "(^|\\.)jup\\.ag$",
      "path": "^/(?:swap/)?[A-Za-z0-9]+-([1-9A-HJ-NP-Za-km-z]{32,44})/?$",
      "confidence": "high"
    },
    {
      "via": "dexscreener",
      "host": "(^|\\.)dexscreener\\.com$",
      "path": "^/solana/([1-9A-HJ-NP-Za-km-z]{32,44})/?$",
      "confidence": "low"
    }
  ],
  "denylist": [
