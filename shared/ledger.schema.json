{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TweetStream sniper state file",
  "description": "state/live.json or state/dry-run.json. Rules in shared/README.md, section Trade state. Lamport amounts are decimal strings, times are Unix milliseconds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode", "purchases", "spend", "positions", "pending"],
  "properties": {
    "version": { "const": 2 },
    "mode": { "enum": ["live", "dry_run"] },
    "purchases": {
      "description": "Every mint the bot bought, by mint. A mint is bought at most once per state file.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "at"],
        "properties": {
          "rule": { "type": "string" },
          "at": { "$ref": "#/$defs/time" }
        }
      }
    },
    "spend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalLamports", "recent"],
      "properties": {
        "totalLamports": { "$ref": "#/$defs/lamports" },
        "recent": {
          "description": "Buys of the last hour, for spend.maxPerHourSol.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tradeId", "at", "lamports"],
            "properties": {
              "tradeId": { "type": "string" },
              "at": { "$ref": "#/$defs/time" },
              "lamports": { "$ref": "#/$defs/lamports" }
            }
          }
        }
      }
    },
    "positions": {
      "description": "Tokens the bot holds, by mint.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "trigger", "route", "tokenProgram", "openedAt", "costLamports", "tokenAmount", "pendingExits"],
        "properties": {
          "rule": { "type": "string" },
          "trigger": { "$ref": "#/$defs/trigger" },
          "route": { "enum": ["pump", "jupiter"] },
          "tokenProgram": { "type": "string" },
          "openedAt": { "$ref": "#/$defs/time" },
          "costLamports": { "$ref": "#/$defs/lamports" },
          "tokenAmount": {
            "description": "Raw token units held; null until a balance read returns more than 0.",
            "oneOf": [{ "$ref": "#/$defs/lamports" }, { "type": "null" }]
          },
          "pendingExits": {
            "description": "Exits waiting for a sell to confirm.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "at"],
              "properties": {
                "code": { "type": "string" },
                "at": { "$ref": "#/$defs/time" }
              }
            }
          }
        }
      }
    },
    "pending": {
      "description": "Trades written before sending whose outcome is not known yet, by trade id.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["side", "mint", "route", "signature", "blockhash", "lastValidBlockHeight", "reservedLamports", "amountLamports", "rule", "trigger", "tokenProgram", "sentAt"],
        "properties": {
          "side": { "enum": ["buy", "sell"] },
          "mint": { "type": "string" },
          "route": { "enum": ["pump", "jupiter"] },
          "signature": {
            "description": "null only when Jupiter returned no signature and the signed transaction had none of ours: it waits for manual review.",
            "type": ["string", "null"]
          },
          "blockhash": { "type": "string" },
          "lastValidBlockHeight": { "type": ["integer", "null"] },
          "reservedLamports": { "description": "Largest possible wallet debit, held against the spend caps; 0 for a sell.", "$ref": "#/$defs/lamports" },
          "amountLamports": { "description": "What a buy spends on the token, which becomes the position's cost; 0 for a sell.", "$ref": "#/$defs/lamports" },
          "rule": { "type": "string" },
          "trigger": { "$ref": "#/$defs/trigger" },
          "tokenProgram": { "type": "string" },
          "sentAt": { "$ref": "#/$defs/time" }
        }
      }
    }
  },
  "$defs": {
    "lamports": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "time": { "type": "integer", "minimum": 0 },
    "trigger": {
      "description": "The event a buy came from; postKey lets a delete of that post sell it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["eventRef"],
      "properties": {
        "eventRef": { "type": "string" },
        "postKey": { "type": "string" }
      }
    }
  }
}
